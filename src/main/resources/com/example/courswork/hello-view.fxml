<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.courswork.util.HelloController">

    <top>
        <VBox alignment="CENTER" spacing="10">

            <ImageView fitHeight="120" fitWidth="120" preserveRatio="true">
                <image>
                    <Image url="@/images/tuktuk_logo.png" />
                </image>
            </ImageView>

            <Label style="-fx-font-size:24px; -fx-font-weight:bold;" text="Malabe Tuk Tuk Spare Parts Management System" />

        </VBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>


            <GridPane hgap="10" vgap="10">
                <Label text="Part ID" />
                <TextField fx:id="txtPartId" GridPane.columnIndex="1" />

                <Label text="Part Name" GridPane.rowIndex="1" />
                <TextField fx:id="txtPartName" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Brand" GridPane.rowIndex="2" />
                <TextField fx:id="txtBrand" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Price" GridPane.rowIndex="3" />
                <TextField fx:id="txtPrice" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Quantity" GridPane.rowIndex="4" />
                <TextField fx:id="txtQuantity" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <Label text="Category" GridPane.rowIndex="5" />
                <TextField fx:id="txtCategory" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                <Label text="Date Added" GridPane.rowIndex="6" />
                <TextField fx:id="txtDate" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                <!-- Added text label for the Image path textfield -->
                <Label text="Image Path" GridPane.rowIndex="7" />
                <TextField fx:id="txtImage" GridPane.columnIndex="1" GridPane.rowIndex="7" />

                <columnConstraints>
                    <ColumnConstraints />
                    <ColumnConstraints />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
            </GridPane>

            <!-- Add/Update/Delete/Clear now all wired to matching controller methods -->
            <HBox spacing="10">
                <Button onAction="#onAddClick" text="Add" />
                <Button onAction="#onUpdateClick" text="Update" />
                <Button onAction="#onDeleteClick" text="Delete" />
                <Button onAction="#onClearClick" text="Clear" />
            </HBox>

            <!-- Summary labels, needed by refreshTable() / refreshLowStock() in the controller -->
            <HBox spacing="20">
                <Label fx:id="totalCountLabel" text="Total Parts: 0" />
                <Label fx:id="totalValueLabel" text="Total Value: Rs. 0.00" />
            </HBox>
            <Label fx:id="lowStockLabel" style="-fx-text-fill: red;" wrapText="true" />

            <!-- Added fx:id to TableColumns to populate columns correctly, plus the Date column -->
            <TableView fx:id="tableParts" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colPartId" text="Part ID" />
                    <TableColumn fx:id="colPartName" text="Part Name" />
                    <TableColumn fx:id="colBrand" text="Brand" />
                    <TableColumn fx:id="colPrice" text="Price" />
                    <TableColumn fx:id="colQty" text="Qty" />
                    <TableColumn fx:id="colCategory" text="Category" />
                    <TableColumn fx:id="colDate" text="Date Added" />
                </columns>
            </TableView>

        </VBox>
    </center>

</BorderPane>
