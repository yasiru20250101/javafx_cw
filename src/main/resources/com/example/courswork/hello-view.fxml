<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.courswork.util.HelloController">

    <top>
        <VBox alignment="CENTER" spacing="10">

            <ImageView fitHeight="120" fitWidth="120" preserveRatio="true">
                <image>
                    <Image url="@/images/tuktuk_logo.png" />
                </image>
            </ImageView>

            <Label style="-fx-font-size:24px; -fx-font-weight:bold;" text="Malabe Tuk Tuk Spare Parts Management System" />

        </VBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <HBox spacing="10">
            <Button onAction="#onDealersClicked" prefHeight="26.0" prefWidth="208.0" text="Dealers" />
            <Button onAction="#onPosClicked" prefHeight="26.0" prefWidth="183.0" text="Point of Sale" />
             <Button onAction="#onAuditLogClicked" prefHeight="26.0" prefWidth="183.0" text="Audit Log" />
            </HBox>



            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Search:" />
                <TextField fx:id="searchField" promptText="Name, brand or part id" HBox.hgrow="ALWAYS" />
                <Label text="Category:" />
                <ComboBox fx:id="categoryFilter" prefWidth="140" />
                <Label text="Min price:" />
                <TextField fx:id="minPriceField" prefWidth="80" />
                <Label text="Max price:" />
                <TextField fx:id="maxPriceField" prefWidth="80" />
                <Button onAction="#onSearchClicked" text="Search" />
                <Button onAction="#onResetClicked" text="Reset" />
            </HBox>



            <HBox spacing="10">
                <Button onAction="#onAddClick" prefHeight="26.0" prefWidth="112.0" text="Add" />
                <Button onAction="#onUpdateClick" prefHeight="26.0" prefWidth="122.0" text="Update" />
                <Button onAction="#onDeleteClick" prefHeight="26.0" prefWidth="122.0" text="Delete" />
            </HBox>

            <HBox spacing="20">
                <Label fx:id="totalCountLabel" text="Total Parts: 0" />
                <Label fx:id="totalValueLabel" text="Total Value: Rs. 0.00" />
                <Label fx:id="totalSalesLabel" text="Total Sales: Rs. 0.00" />
            </HBox>
            <Label fx:id="lowStockLabel" prefHeight="67.0" prefWidth="818.0" style="-fx-text-fill: red;" wrapText="true" />

            <TableView fx:id="tableParts" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colPartId" text="Part ID" />
                    <TableColumn fx:id="colPartName" text="Part Name" />
                    <TableColumn fx:id="colBrand" text="Brand" />
                    <TableColumn fx:id="colPrice" text="Price" />
                    <TableColumn fx:id="colQty" text="Qty" />
                    <TableColumn fx:id="colCategory" text="Category" />
                    <TableColumn fx:id="colDate" text="Date Added" />
                    <TableColumn fx:id="colImage" text="Image" prefWidth="100" />
                </columns>
            </TableView>

        </VBox>
    </center>

</BorderPane>
